classDiagram

    class User {
        +String name
        +String email
        +notify(message)
    }

    class Restaurant {
        +String name
        +getMenu()
        +confirmOrder(order)
    }

    class MenuItem {
        +String name
        +Float price
    }

    class Order {
        +OrderStatus status
        +addItem(item)
        +removeItem(item)
        +confirm()
        +updateStatus(status)
    }

    class OrderStatus {
        <<enumeration>>
        CREATED
        CONFIRMED
        PREPARED
        DELIVERED
    }

    class Platform {
        +createOrder(user, restaurant)
        +placeOrder(order)
        +updateOrderStatus(order, status)
    }

    User "1" --> "0..*" Order : places
    Restaurant "1" --> "0..*" Order : receives
    Restaurant "1" --> "1..*" MenuItem : offers
    Order "0..*" --> "1..*" MenuItem : contains
    Order "1" --> "1" OrderStatus : has

    Platform ..> User : manages
    Platform ..> Restaurant : manages
    Platform ..> Order : manages
